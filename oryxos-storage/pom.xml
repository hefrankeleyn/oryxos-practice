<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.oryxlabs</groupId>
        <artifactId>oryxos-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>oryxos-storage</artifactId>
    <name>OryxOS Storage</name>
    <!-- 持久化层：SQLite + Spring Data JPA（会话、审计、定时任务、通知渠道） -->
    <description>持久化层：SQLite + Spring Data JPA（会话、审计、定时任务、通知渠道）</description>

    <dependencies>
        <!-- 核心抽象：OryxTool、Profile、Session 等 -->
        <dependency>
            <groupId>com.oryxlabs</groupId>
            <artifactId>oryxos-core</artifactId>
        </dependency>
        <!-- Spring Data JPA + Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- SQLite JDBC 驱动（嵌入式，单二进制部署） -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <!-- Hibernate SQLite 方言 -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
            <version>${hibernate.version}</version>
        </dependency>
    </dependencies>
</project>
