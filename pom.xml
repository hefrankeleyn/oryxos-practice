<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        OryxOS 根 POM（聚合 + 依赖版本统一管理）。
        继承 Spring Boot starter parent，复用其插件管理与依赖版本（Lombok、Jackson、Hibernate、SQLite JDBC 等）。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.9</version>
        <relativePath/>
    </parent>

    <groupId>com.oryxlabs</groupId>
    <artifactId>oryxos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>OryxOS</name>
    <description>Java 原生的企业级 Agent 操作系统（Agent Harness OS）</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <!-- 核心阶段 9 个模块，职责见 CLAUDE.md 与 docs/03-TechnicalSolution.md 第 10 章 -->
    <modules>
        <module>oryxos-core</module>
        <module>oryxos-provider</module>
        <module>oryxos-memory</module>
        <module>oryxos-tool</module>
        <module>oryxos-channel-cli</module>
        <module>oryxos-web</module>
        <module>oryxos-storage</module>
        <module>oryxos-cli</module>
        <module>oryxos-boot</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Spring AI：只用 Provider 抽象、协议转换、@Tool schema 生成（禁用自动 tool 执行） -->
        <spring-ai.version>1.0.3</spring-ai.version>
        <!-- Spring AI Alibaba：主流国产 LLM connector，需与 Spring AI 1.0.x 对齐 -->
        <spring-ai-alibaba.version>1.0.0.4</spring-ai-alibaba.version>
        <!-- Picocli：命令行入口 -->
        <picocli.version>4.7.7</picocli.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ========== 内部模块 ========== -->
            <dependency>
                <groupId>com.oryxlabs</groupId>
                <artifactId>oryxos-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.oryxlabs</groupId>
                <artifactId>oryxos-provider</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.oryxlabs</groupId>
                <artifactId>oryxos-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.oryxlabs</groupId>
                <artifactId>oryxos-tool</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.oryxlabs</groupId>
                <artifactId>oryxos-channel-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.oryxlabs</groupId>
                <artifactId>oryxos-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.oryxlabs</groupId>
                <artifactId>oryxos-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.oryxlabs</groupId>
                <artifactId>oryxos-cli</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ========== 第三方 BOM ========== -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== 第三方单体依赖 ========== -->
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 所有模块共享：Lombok（编译期）+ 测试依赖 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                        <!-- 显式声明注解处理器，避免依赖 JDK 的隐式发现行为 -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <!-- 始终生成 package-info.class，骨架阶段的模块 JAR 也不为空 -->
                            <arg>-Xpkginfo:always</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
